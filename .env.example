# -----------------------------------------------------------------------
# GOLD STAR - MT5 LIVE DASHBOARD   |   Environment Variables
# -----------------------------------------------------------------------
# Copy this file to .env.local for local dev, or add each key as a
# Vercel Environment Variable in your project settings.
# -----------------------------------------------------------------------

# ---- REQUIRED: Upstash Redis REST (free tier at https://upstash.com) --
# Create a Redis database → copy "REST URL" and "REST Token" from console.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

# ---- REQUIRED: Webhook Auth Secret -------------------------------------
# Choose any long random string. MUST match the "WebhookSecret" input
# you set inside the GoldStar_Exporter EA in Vantage Markets MT5.
MT5_WEBHOOK_SECRET=change-me-to-a-long-random-secret

# ---- OPTIONAL: Social links shown in Header / Footer ------------------
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/YourUsername
NEXT_PUBLIC_WHATSAPP_NUMBER=+919876543210
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/YourPage
